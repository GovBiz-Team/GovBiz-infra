# 통합 Compose 설정만 둡니다. 서비스별 비밀값은 각 submodule의 .env에서 관리합니다.
COMPOSE_PROJECT_NAME=govbiz-infra
GOVBIZ_APP_ENV_FILE=./services/SKN34-3rd-1Team/.env
GOVBIZ_DJANGO_ENV_FILE=./services/SKN34-4th-1Team/.env

# 기존 로컬 볼륨 재사용 시에만 아래 두 줄을 활성화합니다.
# Windows/Linux/macOS에서 같은 파일 구분자를 사용합니다.
# COMPOSE_PATH_SEPARATOR=|
# COMPOSE_FILE=compose.yaml|compose.existing-data.yaml

# 기본값과 다른 기존 볼륨 이름을 사용할 때만 설정합니다.
# GOVBIZ_EXISTING_MYSQL_VOLUME=govbiz_mysql-data
# GOVBIZ_EXISTING_DJANGO_MYSQL_VOLUME=govbiz4-django_mysql-data
